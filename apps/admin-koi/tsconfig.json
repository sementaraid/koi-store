{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    /* Helpers import each other with an explicit `.ts`, because their tests run
       under `node --experimental-strip-types`, which resolves the specifier
       literally and reads no tsconfig. Same arrangement as storefront-koi. */
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    /* This app's own `@types` only. Without it TS also auto-includes the repo
       root's, which pins React 18 for the admin/vendor panels — two React
       typings in one program is every `ExoticComponent cannot be used as a JSX
       component` error at once. */
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": ["./src/*"],
      /* Type-only access to the generated route map. A package dependency on
         @acme/api would form a workspace cycle. Same alias the other apps use. */
      "@acme/api/_generated": ["../../packages/api/.mercur/routes.d.ts"],
      /* The repo root pins `@types/react@18`; pinning the specifier sends every
         dependency to this app's own React 19 types. */
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
