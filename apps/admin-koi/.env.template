# Where the Mercur backend answers. Server-side only — the back office makes
# every call from a server action or server component, so no NEXT_PUBLIC_ twin
# and no backend URL in the browser bundle.
MEDUSA_BACKEND_URL=http://localhost:9000

# No publishable key here: that header scopes *store* requests to a sales
# channel. This app talks to /admin/*, which authenticates the `user` actor with
# a bearer token instead.
