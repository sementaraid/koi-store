# Copy to .env.prod (gitignored) and fill in. Read by compose.prod.yaml via:
#   docker compose --env-file .env.prod -f compose.prod.yaml up -d
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/koi-store?sslmode=disable
# 32 random bytes, base64. Must match the key the data was encrypted with.
PII_ENCRYPTION_KEY=change-me
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Shared by the API (STOREFRONT_REVALIDATE_SECRET) and the storefront.
REVALIDATE_SECRET=change-me
