{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@mercurjs/core/_generated": ["../api/.mercur/routes.d.ts"],
      "@mercurjs/types": ["node_modules/@mercurjs/types/dist/index.d.ts"],
      "@mercurjs/types/dist/*": ["node_modules/@mercurjs/types/dist/*"],
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@lib/*": ["src/lib/*"],
      "@pages/*": ["src/pages/*"],
      "@providers/*": ["src/providers/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": [
    "src"
  ],
  "composite": false,
  "allowSyntheticDefaultImports": true
}