# Integration tests (run inside the `app` container). Postgres is the compose
# `postgres` service with trust auth, so no password is needed.
DB_HOST=postgres
DB_USERNAME=postgres
DB_PASSWORD=
# US-092 T-092.1 (D-043). Test-only key, base64 of 32 bytes; never used outside
# the test database. Distinct from the dev key in compose.yaml so ciphertext
# written by tests cannot be read with the committed dev key.
PII_ENCRYPTION_KEY=cDcnwOQrLyBFafjNrqZPDqBOIef9Ekvx8A0He4CDDhw=
