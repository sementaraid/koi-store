# Integration tests (run on the host). Postgres is compose.prod.yaml's
# `postgres` on 127.0.0.1:5432 with trust auth, so no password is needed. Each
# run creates and drops its own `medusa-<ulid>-integration-*` databases.
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=
# US-092 T-092.1 (D-043). Test-only key, base64 of 32 bytes; never used outside
# the test database. Distinct from the dev/prod key so ciphertext
# written by tests cannot be read with the committed dev key.
PII_ENCRYPTION_KEY=cDcnwOQrLyBFafjNrqZPDqBOIef9Ekvx8A0He4CDDhw=
