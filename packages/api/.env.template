STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
MERCUR_VENDOR_URL=http://localhost:7001
# Storefront on-demand revalidation. The URL must be the route itself, and the
# secret must equal REVALIDATE_SECRET in apps/storefront-koi/.env.
STOREFRONT_REVALIDATE_URL=http://localhost:3001/api/revalidate
STOREFRONT_REVALIDATE_SECRET=supersecret
# Password-reset email over SMTP (US-002). Leave SMTP_HOST empty to disable
# email entirely; compose.yaml points it at the Mailpit service in dev.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Koi Store <no-reply@example.com>"
# Seeded admin-koi login (bun run seed). Empty = admin@koi.dev / supersecret.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Base URL of storefront-koi, used in the reset link (/atur-sandi?token=...).
STOREFRONT_URL=http://localhost:3001
# US-092 (D-043): AES-256-GCM key for column-level PII encryption, base64 of 32
# random bytes. Never commit the real key; generate with:
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=
# US-093: days a private KTP upload with no seller reference is kept before
# the `delete-orphan-ktp` job deletes it. Empty or invalid = 30 days.
ORPHAN_KTP_RETENTION_DAYS=
