{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "preserve",
    /* This package's own React 19 typings. Without it TS climbs to the repo
       root, which pins `@types/react@18` for Mercur's admin/vendor panels, and
       the kit's React 19 components stop typechecking. The consuming apps
       resolve `@koi/ui`'s source inside their own program, so their tsconfigs
       keep their own `react` path alias; this one only serves `tsc` here. */
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
